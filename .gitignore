# --------------------------------------------------------------------------
# This file is load-bearing for the workshop's git catch-up flow.
#
# Notebooks and scripts generate runtime artifacts on every run. If any of
# them are tracked, every student's working tree is dirty after every run,
# and `git switch` to a step-* branch conflicts — which silently breaks the
# "checkout a branch to catch up" mechanism the lab depends on.
#
# Rule: if running the notebooks creates it, it belongs here.
# --------------------------------------------------------------------------

# Secrets
.env
.env.local

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# marimo
__marimo__/
.marimo.toml

# Agent runtime artifacts.
# NOTE: gitignore has no trailing comments — a comment after a pattern on the
# same line becomes part of the pattern and silently matches nothing.
# lancedb/ is the vector store built by notebook 05.
# *.db is Agno's SQLite session store.
lancedb/
lancedb_demo/
*.db
*.db-journal
*.sqlite
*.sqlite3
.data/

# Fetched by scripts/fetch_data.py during phase 0, not committed.
# What IS committed: the manifest, the prebuilt index, the example traces
# and the label file. See data/README.md.
data/docs/
data/nuforc.parquet
data/.cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
