# Copy this file to `.env` and fill in your own keys.
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows cmd)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is git-ignored. Never commit it.

# --- Required ---------------------------------------------------------------

# Google AI Studio. Free, no credit card.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Langfuse Cloud, EU region. Free Hobby tier.
# https://cloud.langfuse.com  ->  Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Telegram, from @BotFather. Needed in session 2 only. Never expires.
TELEGRAM_TOKEN=

# Proves an incoming webhook really came from Telegram. NOT optional: Agno
# rejects every unsigned update with 403, so a bot without this answers nobody.
# Any hard-to-guess string works. `scripts/serve_bot.py` generates one for you
# the first time you run it, and writes it here.
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Which Telegram chats the bot will answer, comma separated. Leave empty and
# anyone who finds your bot can spend your Gemini quota and land in your
# Langfuse traces — which also pollutes the conversations you are collecting
# for session 2. Message your bot once: the console prints your chat id.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Optional ---------------------------------------------------------------

# Only needed if you want to RUN the multi-provider comparison in notebook 01
# yourself. The notebook ships with committed outputs, so you can skip these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tuning -----------------------------------------------------------------

# The workshop default. Free tier: 15 RPM, against 10 RPM for the full flash
# models, which is not enough for agent loops.
# If the API says the model is "no longer available to new users", Google has
# retired it for new keys: run `uv run python scripts/check.py`, which lists the
# models your key can see, and put one of them here.
STARGATE_MODEL=gemini-3.1-flash-lite

# Set to 1 to print how many LLM calls each agent run costs.
STARGATE_COUNT_CALLS=1
