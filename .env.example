# Copy this file to `.env` and fill in your own keys.
#   cp .env.example .env          (macOS / Linux)
#   copy .env.example .env        (Windows cmd)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is git-ignored. Never commit it.

# --- Required ---------------------------------------------------------------

# Google AI Studio. Free, no credit card.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Langfuse Cloud, EU region. Free Hobby tier.
# https://cloud.langfuse.com  ->  Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Telegram, from @BotFather. Needed in session 2 only. Never expires.
TELEGRAM_TOKEN=

# --- Optional ---------------------------------------------------------------

# Only needed if you want to RUN the multi-provider comparison in notebook 01
# yourself. The notebook ships with committed outputs, so you can skip these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tuning -----------------------------------------------------------------

# The workshop default. Free tier: 15 RPM / 1000 RPD.
# `gemini-2.5-flash` is only 10 RPM, which is not enough for agent loops.
STARGATE_MODEL=gemini-2.5-flash-lite

# Set to 1 to print how many LLM calls each agent run costs.
STARGATE_COUNT_CALLS=1
